# ABDM Configuration
ABDM_BASE_URL=https://abha.abdm.gov.in
ABDM_SANDBOX_BASE_URL=https://sandbox.abdm.gov.in
ABDM_API_KEY=your_abdm_api_key_here
ABDM_API_SECRET=your_abdm_api_secret_here
ABDM_HIP_ID=your_hip_id_here
ABDM_HIP_NAME=Chikit Facility
ABDM_CALLBACK_URL=https://your-chikit-domain.com/abdm/callback
ABDM_TOKEN_EXPIRY_MINUTES=60

# MedGemma Offline AI Configuration
MEDGEMMA_INFERENCE_URL=http://localhost:8000  # URL for local MedGemma inference server
MEDGEMMA_MODEL_NAME=medgemma-4b-it           # MedGemma model variant to use

# JWT Secret (for internal Chikit authentication)
JWT_SECRET=your_jwt_secret_here